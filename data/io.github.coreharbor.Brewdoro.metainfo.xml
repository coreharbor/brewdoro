<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.coreharbor.Brewdoro</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Brewdoro</name>
  <summary>A minimal Pomodoro timer</summary>
  <summary xml:lang="ru">Минималистичный Pomodoro-таймер</summary>
  <summary xml:lang="zh_CN">简洁的番茄工作法计时器</summary>
  <description>
    <p>
      Brewdoro is a focused desktop timer with focus, short break, and long
      break modes. Its animated coffee cup shows the progress of each session.
    </p>
    <p xml:lang="ru">
      Brewdoro — компактный таймер с режимами фокуса, короткого и длинного
      перерыва. Анимированная чашка кофе показывает ход текущей сессии.
    </p>
    <p xml:lang="zh_CN">
      Brewdoro 是一款简洁的桌面计时器，支持专注、短休息和长休息模式。
      动画咖啡杯会显示当前计时进度。
    </p>
  </description>
  <launchable type="desktop-id">io.github.coreharbor.Brewdoro.desktop</launchable>
  <developer id="io.github.coreharbor">
    <name>coreharbor</name>
  </developer>
  <url type="homepage">https://github.com/coreharbor/brewdoro</url>
  <url type="bugtracker">https://github.com/coreharbor/brewdoro/issues</url>
  <url type="vcs-browser">https://github.com/coreharbor/brewdoro</url>
  <url type="contribute">https://github.com/coreharbor/brewdoro/blob/main/CONTRIBUTING.md</url>
  <provides>
    <id>ru.brewdoro.timer.desktop</id>
  </provides>
  <replaces>
    <id>ru.brewdoro.timer</id>
  </replaces>
  <categories>
